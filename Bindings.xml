<Bindings>
	<Binding name="GOLDTRACK_TOGGLE" category="GoldTrack">
		GoldTrackBindingToggleMain()
	</Binding>
	<Binding name="GOLDTRACK_STARTSTOP" category="GoldTrack">
		GoldTrackBindingStartStop()
	</Binding>
	<Binding name="GOLDTRACK_HUD" category="GoldTrack">
		GoldTrackBindingToggleHUD()
	</Binding>
	<Binding name="GOLDTRACK_RESET" category="GoldTrack">
		GoldTrackBindingReset()
	</Binding>
</Bindings>
